<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_blue"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:id="@+id/widget_status_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.1"
        android:text="ĐANG TRỰC"
        android:textColor="#A8C7FA"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Kíp C • Ca sáng"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_time_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="07:00 – 15:00 · còn 2 giờ 44 phút"
        android:textColor="#D6E4FF"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/widget_members"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Chưa cập nhật danh sách nhân sự"
        android:textColor="#F1F5FF"
        android:textSize="14sp" />

</LinearLayout>
